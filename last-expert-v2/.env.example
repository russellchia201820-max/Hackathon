# All keys come from the hackathon "My Pass" page.

# --- Required: Anthropic ---
ANTHROPIC_API_KEY=
# LLM roles (provider: anthropic | openai_compatible). Analyst always stays on Claude.
FAST_PROVIDER=anthropic
FAST_MODEL=claude-haiku-5-5
ANALYST_PROVIDER=anthropic
ANALYST_MODEL=claude-sonnet-5-5
# Optional: OpenAI-compatible endpoint for the fast role only (unused by default)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Voice: ElevenLabs (STT = Scribe v2 realtime, TTS) + LiveKit ---
ELEVENLABS_API_KEY=
# A warm, natural voice from the ElevenLabs Voice Library (blank = plugin default)
ELEVENLABS_VOICE_ID=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Seconds of silence before the agent treats the expert's turn as finished
TURN_END_DELAY_S=1.2

# --- Avatar (M5): anam | synthesia. Falls back to the other, then voice-only. ---
AVATAR_ENABLED=false
AVATAR_PROVIDER=synthesia
ANAM_API_KEY=
ANAM_AVATAR_ID=
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=

# --- Interview ---
MAX_TURNS=30
