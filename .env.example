# --- Required ---
ANTHROPIC_API_KEY=
# LLM roles (provider: anthropic | openai_compatible)
FAST_PROVIDER=anthropic
FAST_MODEL=claude-haiku-5-5
ANALYST_PROVIDER=anthropic
ANALYST_MODEL=claude-sonnet-5-5
# Optional: OpenAI-compatible endpoint for the fast role (e.g. Groq)
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=

# --- Voice (M4) ---
DEEPGRAM_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TTS_PROVIDER=deepgram          # deepgram | elevenlabs
ELEVENLABS_API_KEY=
# Seconds of silence before the agent treats the expert's turn as finished
TURN_END_DELAY_S=1.2

# --- Avatar (M5) ---
AVATAR_ENABLED=false
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=

# --- Interview ---
MAX_TURNS=30
PORT=8000
